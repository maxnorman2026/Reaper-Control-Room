@init
g = 0;
hg = 0;
sg = 0;
cmgs = 1;     // smoothed cues master gain
ncue = 6;  next = 6;  nmon = 6;
k = 0.70710678;
last_cap = 0;
drag_id = 0;
edit_id = 0;
kstyle = 0;   // 1 = SSL-style main level knob, 0 = standard knob
last_click_f = -1000;
last_click_id = 0;
fcount = 0;
klast_y = 0;
strcpy(#ebuf, "");
mem = 0;
// memory map: 0-43 HP state, 100-143 LP state, 200-212 meters,
//             300-387 filter coefficients (8 per channel)
memset(0, 0, 832);
// speaker on/off: smoothed gains at mem[220..232], targets at mem[240..252]
i = 0;
loop(13, mem[220 + i] = 1; mem[240 + i] = 1; i += 1);
// cue send faders: smoothed gains at mem[400..405], targets at mem[410..415],
// post-fader cue samples at mem[420..431]
i = 0;
loop(6, mem[400 + i] = 1; mem[410 + i] = 1; i += 1);
// cue talkback dim: smoothed gains at mem[520..525], targets at mem[530..535]
i = 0;
loop(6, mem[520 + i] = 1; mem[530 + i] = 1; i += 1);

function fold(a, b) local(m) (
  m = (spl(a) + spl(b)) * 0.5;
  spl(a) = m;
  spl(b) = m;
);

// Compute high-pass + low-pass coefficients for one channel (Butterworth Q = 0.7071)
// layout at cb: 0 hb0, 1 hb1, 2 hb2, 3 lb0, 4 lb1, 5 lb2, 6 a1, 7 a2
function setco(ch, fc) local(cb, w0, cw, al, a0i) (
  cb  = 300 + ch * 8;
  fc  = min(fc, srate * 0.45);
  w0  = 2 * $pi * fc / srate;
  cw  = cos(w0);
  al  = sin(w0) / (2 * 0.70710678);
  a0i = 1 / (1 + al);
  mem[cb]     = (1 + cw) * 0.5 * a0i;
  mem[cb + 1] = -(1 + cw) * a0i;
  mem[cb + 2] = mem[cb];
  mem[cb + 3] = (1 - cw) * 0.5 * a0i;
  mem[cb + 4] = (1 - cw) * a0i;
  mem[cb + 5] = mem[cb + 3];
  mem[cb + 6] = -2 * cw * a0i;
  mem[cb + 7] = (1 - al) * a0i;
);

// one biquad stage, high-pass; state at mem[o], mem[o+1]
function hp1(x, o, cb) local(y) (
  y = mem[cb] * x + mem[o];
  mem[o]     = mem[cb + 1] * x - mem[cb + 6] * y + mem[o + 1];
  mem[o + 1] = mem[cb + 2] * x - mem[cb + 7] * y;
  y;
);
// one biquad stage, low-pass
function lp1(x, o, cb) local(y) (
  y = mem[cb + 3] * x + mem[o];
  mem[o]     = mem[cb + 4] * x - mem[cb + 6] * y + mem[o + 1];
  mem[o + 1] = mem[cb + 5] * x - mem[cb + 7] * y;
  y;
);
// Linkwitz-Riley 4 = two cascaded Butterworth stages, per channel ch (0-10)
function hp(x, ch) local(o, cb) (
  o = ch * 4;  cb = 300 + ch * 8;
  hp1(hp1(x, o, cb), o + 2, cb);
);
function lp(x, ch) local(o, cb) (
  o = 100 + ch * 4;  cb = 300 + ch * 8;
  lp1(lp1(x, o, cb), o + 2, cb);
);

// meter peak hold
function pk(i, v) local(a) (
  a = abs(v);
  a > mem[200 + i] ? mem[200 + i] = a;
);

// ---- channel formats: 0 7.2.4, 1 7.1.4, 2 5.2, 3 5.1, 4 Quad, 5 Stereo ----
// speaker index space: 0 L, 1 R, 2 C, 3 LFE1, 4 LFE2, 5 Lss(Ls), 6 Rss(Rs), 7 Lrs, 8 Rrs, 9 Ltf, 10 Rtf, 11 Ltr, 12 Rtr
function fmt_n(f) ( f == 0 ? 13 : (f == 1 ? 12 : (f == 2 ? 7 : (f == 3 ? 6 : (f == 4 ? 4 : 2)))) );
function fmt_idx(f, j) (
  f == 1 ? (j < 4 ? j : j + 1) : (f == 3 ? (j < 4 ? j : j + 1) : (f == 4 ? (j < 2 ? j : j + 3) : j))
);
// does the format use speaker index ix (the subs of Quad / Stereo count as used)
function fmt_has(f, ix) (
  f == 0 ? 1 : (f == 1 ? (ix != 4) : (f == 2 ? (ix < 7) : (f == 3 ? (ix < 7 && ix != 4) : (f == 4 ? (ix < 2 || (ix >= 3 && ix <= 6)) : (ix < 2 || ix == 3 || ix == 4)))))
);
function fmt_str(f) (
  f == 0 ? strcpy(#fnm, "7.2.4") : (f == 1 ? strcpy(#fnm, "7.1.4") : (f == 2 ? strcpy(#fnm, "5.2") : (f == 3 ? strcpy(#fnm, "5.1") : (f == 4 ? strcpy(#fnm, "Quad") : strcpy(#fnm, "Stereo")))));
);
function mfmt(k) (
  max(0, min(5, (k == 0 ? slider167 : (k == 1 ? slider168 : (k == 2 ? slider169 : (k == 3 ? slider170 : (k == 4 ? slider171 : slider172))))) | 0))
);
function mout(k) ( k == 0 ? slider34 : (k == 1 ? slider35 : (k == 2 ? slider36 : (k == 3 ? slider37 : (k == 4 ? slider139 : slider140)))) );
// mono fold of a speaker pair in the speaker signal table
function foldm(a, b) local(m) (
  m = (mem[1200 + a] + mem[1200 + b]) * 0.5;
  mem[1200 + a] = m;  mem[1200 + b] = m;
);
// pop-up list of the six formats (current one ticked); returns 0-5, or -1 when dismissed
function dd_menu(cur) local(i, r) (
  strcpy(#ddm, "");
  i = 0;
  loop(6,
    fmt_str(i);
    strcat(#ddm, i == cur ? "!" : "");
    strcat(#ddm, #fnm);
    i < 5 ? strcat(#ddm, "|");
    i += 1;
  );
  gfx_x = mouse_x;  gfx_y = mouse_y;
  r = gfx_showmenu(#ddm);
  r > 0 ? r - 1 : -1;
);

// a source choice that points at a cue / EXT that is switched off falls back to MIX
function srcfix(x) (
  (x >= 1 && x <= 6 && x > ncue) ? 0 : ((x >= 7 && x - 6 > next) ? 0 : x)
);

// copy n raw inputs starting at src (0-based) into the internal channel layout at dst; out of range = silence
function in_map(dst, src, n) local(j, q) (
  j = 0;
  loop(n, q = src + j; spl(dst + j) = (q >= 0 && q < 64) ? mem[900 + q] : 0; j += 1;);
);

// meter peak hold at an arbitrary memory address
function pk2(a, v) local(x) (
  x = abs(v);
  x > mem[a] ? mem[a] = x;
);

// fetch a stereo source into sl / sr: sel 0-5 = CUE 1-6 (post-fader), 6-11 = EXT 1-6
// EXT 1 = channels 29/30 (first pair of its 14), EXT 2 = 43/44, EXT 3 = 45/46, EXT 4 = 47/48,
// EXT 5 = channels 49/50 and EXT 6 = channels 51/52 (stereo).
// EXT n (0-5) channel j (0-13) from the per-EXT buffer; channels beyond that EXT's channel count are silent
function ext_ch(n, j) ( j < mem[1520 + n] ? mem[1600 + n * 16 + j] : 0 );

function getsrc(sel) (
  sel < 6 ? (
    sl = mem[420 + 2 * sel];  sr = mem[421 + 2 * sel];
  ) : (
    sl = mem[1700 + 2 * (sel - 6)];  sr = mem[1701 + 2 * (sel - 6)];   // EXT pair: channels 1/2 of that EXT (mono feeds both)
  );
);

@block
set   = min(slider1 | 0, max(1, min(6, slider166 | 0)) - 1);   // a monitor beyond the monitor count falls back to the last one in use
af    = mfmt(set);                                // format of the active monitor
fm    = max(0, min(5, slider174 | 0));            // format of the main mix bus
nmix  = fmt_n(fm);
ks    = fm < 2 ? k : 1;                           // 7.x mix: side + rear surrounds fold together at -3 dB; 5.x and smaller: surrounds pass at full level
nafo  = fmt_n(af);                                // channels of the active format
nafs  = nafo + (af >= 4 ? 2 : 0);                 // plus the two sub outputs for Quad / Stereo
os    = max(0, min(64 - nafo, (mout(set) | 0) - 1));
osub  = max(0, min(62, (slider173 | 0) - 1));
dimg  = slider2 ? pow(10, slider3 / 20) : 1;
target = slider5 ? 0 : pow(10, slider6 / 20) * dimg;

// headphone level and source (independent of speaker level / dim / mute)
hpt = slider143 ? 0 : pow(10, slider39 / 20) * (slider144 ? pow(10, slider3 / 20) : 1);   // headphone level, mute, dim (shared dim level)
stt = slider145 ? 0 : pow(10, slider130 / 20) * (slider146 ? pow(10, slider3 / 20) : 1);   // studio monitors level, mute, dim (shared dim level)
ncue = max(0, min(6, slider164 | 0));   // number of cues in use
nmon = max(1, min(6, slider166 | 0));  // number of monitors (speaker sets) in use
next = max(0, min(6, slider165 | 0));   // number of EXT inputs in use
ssrc = srcfix(slider131 | 0);   // studio monitors source: 0 MIX, 1-6 CUE, 7-12 EXT
src = srcfix(slider40 | 0);
msrc = srcfix(slider63 | 0);   // main monitor source: 0 MIX, 1-6 CUE, 7-12 EXT

bmon  = slider7 ? 1 : 0;
subg  = pow(10, slider9 / 20);
lfeg  = pow(10, slider11 / 20);
bto   = slider10 | 0;

// bass management applies to every monitor format
bm = bmon ? 1 : 0;
// per-channel bass management flags (0 or 1)
fL   = bm * (slider12 ? 1 : 0);
fR   = bm * (slider13 ? 1 : 0);
fC   = bm * (slider14 ? 1 : 0);
fLss = bm * (slider15 ? 1 : 0);
fRss = bm * (slider16 ? 1 : 0);
fLrs = bm * (slider17 ? 1 : 0);
fRrs = bm * (slider18 ? 1 : 0);
fLtf = bm * (slider19 ? 1 : 0);
fRtf = bm * (slider20 ? 1 : 0);
fLtr = bm * (slider21 ? 1 : 0);
fRtr = bm * (slider22 ? 1 : 0);

// plug-in input / output routing (start channels from the Routing section)
ci_mix = max(0, min(64 - nmix, (slider149 | 0) - 1));    // nmix channels, set by the mix bus format
ci_tlk = max(0, min(63, (slider150 | 0) - 1));
ci_lis = max(0, min(63, (slider151 | 0) - 1));
mem[1500] = max(0, min(62, (slider175 | 0) - 1));   // cue 1 input start
mem[1501] = max(0, min(62, (slider176 | 0) - 1));   // cue 2 input start
mem[1502] = max(0, min(62, (slider177 | 0) - 1));   // cue 3 input start
mem[1503] = max(0, min(62, (slider178 | 0) - 1));   // cue 4 input start
mem[1504] = max(0, min(62, (slider179 | 0) - 1));   // cue 5 input start
mem[1505] = max(0, min(62, (slider180 | 0) - 1));   // cue 6 input start
mem[1520] = max(1, min(14, slider187 | 0));  mem[1530] = max(0, min(64 - mem[1520], (slider153 | 0) - 1));   // EXT 1 channel count / input start
mem[1521] = max(1, min(14, slider188 | 0));  mem[1531] = max(0, min(64 - mem[1521], (slider154 | 0) - 1));   // EXT 2 channel count / input start
mem[1522] = max(1, min(14, slider189 | 0));  mem[1532] = max(0, min(64 - mem[1522], (slider155 | 0) - 1));   // EXT 3 channel count / input start
mem[1523] = max(1, min(14, slider190 | 0));  mem[1533] = max(0, min(64 - mem[1523], (slider156 | 0) - 1));   // EXT 4 channel count / input start
mem[1524] = max(1, min(14, slider191 | 0));  mem[1534] = max(0, min(64 - mem[1524], (slider157 | 0) - 1));   // EXT 5 channel count / input start
mem[1525] = max(1, min(14, slider192 | 0));  mem[1535] = max(0, min(64 - mem[1525], (slider158 | 0) - 1));   // EXT 6 channel count / input start
oc_hp  = max(0, min(62, (slider160 | 0) - 1));
oc_mt  = max(0, min(62, (slider161 | 0) - 1));
mem[1510] = max(0, min(62, (slider181 | 0) - 1));   // cue 1 output start
mem[1511] = max(0, min(62, (slider182 | 0) - 1));   // cue 2 output start
mem[1512] = max(0, min(62, (slider183 | 0) - 1));   // cue 3 output start
mem[1513] = max(0, min(62, (slider184 | 0) - 1));   // cue 4 output start
mem[1514] = max(0, min(62, (slider185 | 0) - 1));   // cue 5 output start
mem[1515] = max(0, min(62, (slider186 | 0) - 1));   // cue 6 output start
oc_stu = max(0, min(62, (slider163 | 0) - 1));


// per-channel crossover coefficients
setco(0,  slider23);
setco(1,  slider24);
setco(2,  slider25);
setco(3,  slider26);
setco(4,  slider27);
setco(5,  slider28);
setco(6,  slider29);
setco(7,  slider30);
setco(8,  slider31);
setco(9,  slider32);
setco(10, slider33);

// per-speaker on/off targets (channel order: L R C LFE1 LFE2 Lss Rss Lrs Rrs Ltf Rtf Ltr Rtr)
mem[240] = slider43 ? 1 : 0;
mem[241] = slider44 ? 1 : 0;
mem[242] = slider45 ? 1 : 0;
mem[243] = slider46 ? 1 : 0;
mem[244] = slider47 ? 1 : 0;
mem[245] = slider48 ? 1 : 0;
mem[246] = slider49 ? 1 : 0;
mem[247] = slider50 ? 1 : 0;
mem[248] = slider51 ? 1 : 0;
mem[249] = slider52 ? 1 : 0;
mem[250] = slider53 ? 1 : 0;
mem[251] = slider54 ? 1 : 0;
mem[252] = slider55 ? 1 : 0;

// cue send fader targets (at or below -60 dB = off)
mem[410] = (slider118 && slider56 > -60) ? pow(10, slider56 / 20) : 0;
mem[411] = (slider119 && slider57 > -60) ? pow(10, slider57 / 20) : 0;
mem[412] = (slider120 && slider58 > -60) ? pow(10, slider58 / 20) : 0;
mem[413] = (slider121 && slider59 > -60) ? pow(10, slider59 / 20) : 0;
mem[414] = (slider122 && slider60 > -60) ? pow(10, slider60 / 20) : 0;
mem[415] = (slider123 && slider61 > -60) ? pow(10, slider61 / 20) : 0;

// cue talkback targets (on = level in dB, off = silent)
mem[450] = (slider64 && slider133) ? pow(10, slider70 / 20) : 0;
mem[451] = (slider65 && slider134) ? pow(10, slider71 / 20) : 0;
mem[452] = (slider66 && slider135) ? pow(10, slider72 / 20) : 0;
mem[453] = (slider67 && slider136) ? pow(10, slider73 / 20) : 0;
mem[454] = (slider68 && slider137) ? pow(10, slider74 / 20) : 0;
mem[455] = (slider69 && slider138) ? pow(10, slider75 / 20) : 0;
// cue dim while talkback is on (unity otherwise)
mem[530] = (slider64 && slider133 && slider124) ? pow(10, slider112 / 20) : 1;
mem[531] = (slider65 && slider134 && slider125) ? pow(10, slider113 / 20) : 1;
mem[532] = (slider66 && slider135 && slider126) ? pow(10, slider114 / 20) : 1;
mem[533] = (slider67 && slider136 && slider127) ? pow(10, slider115 / 20) : 1;
mem[534] = (slider68 && slider137 && slider128) ? pow(10, slider116 / 20) : 1;
mem[535] = (slider69 && slider138 && slider129) ? pow(10, slider117 / 20) : 1;

// cue send source flags: mem[460 + 5*cue + (0 CUE, 1 MIX, 2 EXT1, 3 EXT2, 4 EXT3)]
mem[460] = slider82 ? 1 : 0;
mem[461] = slider83 ? 1 : 0;
mem[462] = slider84 ? 1 : 0;
mem[463] = slider85 ? 1 : 0;
mem[464] = slider86 ? 1 : 0;
mem[465] = slider87 ? 1 : 0;
mem[466] = slider88 ? 1 : 0;
mem[467] = slider89 ? 1 : 0;
mem[468] = slider90 ? 1 : 0;
mem[469] = slider91 ? 1 : 0;
mem[470] = slider92 ? 1 : 0;
mem[471] = slider93 ? 1 : 0;
mem[472] = slider94 ? 1 : 0;
mem[473] = slider95 ? 1 : 0;
mem[474] = slider96 ? 1 : 0;
mem[475] = slider97 ? 1 : 0;
mem[476] = slider98 ? 1 : 0;
mem[477] = slider99 ? 1 : 0;
mem[478] = slider100 ? 1 : 0;
mem[479] = slider101 ? 1 : 0;
mem[480] = slider102 ? 1 : 0;
mem[481] = slider103 ? 1 : 0;
mem[482] = slider104 ? 1 : 0;
mem[483] = slider105 ? 1 : 0;
mem[484] = slider106 ? 1 : 0;
mem[485] = slider107 ? 1 : 0;
mem[486] = slider108 ? 1 : 0;
mem[487] = slider109 ? 1 : 0;
mem[488] = slider110 ? 1 : 0;
mem[489] = slider111 ? 1 : 0;

// meter decay (about 0.3 s)
dec = exp(-samplesblock / (srate * 0.3));
mi = 0;
loop(14, mem[200 + mi] *= dec; mi += 1);
mi = 0;
loop(12, mem[260 + mi] *= dec; mi += 1);
mem[282] *= dec;  mem[283] *= dec;
mem[284] *= dec;  mem[285] *= dec;
mi = 0;
loop(64, mem[600 + mi] *= dec; mi += 1);
mi = 0;
loop(64, mem[700 + mi] *= dec; mi += 1);
mi = 0;
loop(13, mem[500 + mi] *= dec; mi += 1);

@sample
g += (target - g) * 0.002;   // smoothed gain, avoids clicks
hg += (hpt - hg) * 0.002;    // smoothed headphone gain
sg += (stt - sg) * 0.002;    // smoothed studio monitors gain
cmgs += ((slider148 <= -60 ? 0 : pow(10, slider148 / 20)) - cmgs) * 0.002;   // smoothed cues master gain

// input routing: keep the raw inputs (input check shows these), then place each source at the fixed internal
// position the rest of the code reads (mix 1-13, talkback 15, listen 16, cues 17-28, EXT 1 29-42, EXT 2-6 43-52)
i = 0;
loop(64, mem[900 + i] = spl(i); pk2(600 + i, spl(i)); i += 1);
i = 0;  loop(14, spl(i) = 0; i += 1;);
i = 0;  loop(nmix, q = ci_mix + i;  spl(fmt_idx(fm, i)) = (q < 64) ? mem[900 + q] : 0;  i += 1;);   // mix bus channels into the speaker index layout
in_map(14, ci_tlk, 1);  in_map(15, ci_lis, 1);
in_map(16, mem[1500], 2);  in_map(18, mem[1501], 2);  in_map(20, mem[1502], 2);
in_map(22, mem[1503], 2);  in_map(24, mem[1504], 2);  in_map(26, mem[1505], 2);
ex_i = 0;
loop(6,
  ex_c = mem[1520 + ex_i];  ex_s = mem[1530 + ex_i];  ex_j = 0;
  loop(14, ex_q = ex_s + ex_j;  mem[1600 + ex_i * 16 + ex_j] = (ex_j < ex_c && ex_q < 64) ? mem[900 + ex_q] : 0;  ex_j += 1;);
  mem[1700 + 2 * ex_i] = mem[1600 + ex_i * 16];
  mem[1701 + 2 * ex_i] = ex_c > 1 ? mem[1601 + ex_i * 16] : mem[1600 + ex_i * 16];
  ex_i += 1;
);

L = spl0;  R = spl1;  C = spl2;  LF1 = spl3; LF2 = spl4;
Lss = spl5; Rss = spl6; Lrs = spl7; Rrs = spl8;
Ltf = spl9; Rtf = spl10; Ltr = spl11; Rtr = spl12;

tk = spl(14);   // talkback bus (master channel 15, mono)

// mix as heard by a cue's MIX source (ITU fold-down of the raw mix)
cmL = (L + k * Ltf) + k * C + k * (ks * (Lss + Lrs) + k * Ltr);
cmR = (R + k * Rtf) + k * C + k * (ks * (Rss + Rrs) + k * Rtr);

// cue sends: sum of the enabled sources (CUE bus, MIX, EXT 1-3), then the cue fader.
// Kept for monitoring / pass-through.
i = 0;
loop(6,
  mem[400 + i] += (mem[410 + i] - mem[400 + i]) * 0.002;
  cf  = 460 + 5 * i;
  cql = mem[cf] * spl(16 + 2 * i) + mem[cf + 1] * cmL + (next >= 1 ? mem[cf + 2] * mem[1700] : 0) + (next >= 2 ? mem[cf + 3] * mem[1702] : 0) + (next >= 3 ? mem[cf + 4] * mem[1704] : 0);
  cqr = mem[cf] * spl(17 + 2 * i) + mem[cf + 1] * cmR + (next >= 1 ? mem[cf + 2] * mem[1701] : 0) + (next >= 2 ? mem[cf + 3] * mem[1703] : 0) + (next >= 3 ? mem[cf + 4] * mem[1705] : 0);
  mem[420 + 2 * i] = cql * mem[400 + i];
  mem[421 + 2 * i] = cqr * mem[400 + i];
  mem[440 + i] += (mem[450 + i] - mem[440 + i]) * 0.002;   // talkback gain, smoothed
  mem[520 + i] += (mem[530 + i] - mem[520 + i]) * 0.002;   // talkback dim, smoothed
  i += 1;
);

// raw ITU fold-down of the mix (before bass management) for the MIX headphone source
rL5  = L + k * Ltf;
rR5  = R + k * Rtf;
rLs5 = ks * (Lss + Lrs) + k * Ltr;
rRs5 = ks * (Rss + Rrs) + k * Rtr;
rLo  = rL5 + k * C + k * rLs5;
rRo  = rR5 + k * C + k * rRs5;

// headphone source (read before outputs are cleared)
// 0 = MIX, 1-6 = CUE 1-6 (master ch 25-36), 7-12 = EXT 1-6 (master ch 37-48)
src == 0 ? (
  hpl = rLo;  hpr = rRo;
) : (
  getsrc(src - 1);
  hpl = sl;  hpr = sr;
);

// studio monitors feed (stereo): the mix, a cue or an EXT pair
ssrc == 0 ? (
  stuL = rLo;  stuR = rRo;
) : (
  getsrc(ssrc - 1);
  stuL = sl;  stuR = sr;
);

// main monitor source: a cue or ext pair replaces the mix on the L/R speakers
// (the mix for the headphone MIX source was already taken above)
msrc >= 7 ? (
  // an EXT source plays its channels laid out like the mix (L R C LFE1 LFE2 Lss Rss Lrs Rrs Ltf Rtf Ltr Rtr);
  // a mono EXT feeds L and R, channel 14 only shows on the source meter
  xn = msrc - 7;
  L = ext_ch(xn, 0);   R = mem[1520 + xn] > 1 ? ext_ch(xn, 1) : L;   C = ext_ch(xn, 2);   LF1 = ext_ch(xn, 3);  LF2 = ext_ch(xn, 4);
  Lss = ext_ch(xn, 5); Rss = ext_ch(xn, 6); Lrs = ext_ch(xn, 7); Rrs = ext_ch(xn, 8);
  Ltf = ext_ch(xn, 9); Rtf = ext_ch(xn, 10); Ltr = ext_ch(xn, 11); Rtr = ext_ch(xn, 12);
  pk(13, ext_ch(xn, 13));
) : msrc != 0 ? (
  getsrc(msrc - 1);
  L = sl;  R = sr;  C = 0;  LF1 = 0;  LF2 = 0;
  Lss = 0; Rss = 0; Lrs = 0; Rrs = 0;
  Ltf = 0; Rtf = 0; Ltr = 0; Rtr = 0;
);

// feed for the external meter (hardware 23/24): stereo fold-down of what the main monitors play
mtL = (L + k * Ltf) + k * C + k * (ks * (Lss + Lrs) + k * Ltr);
mtR = (R + k * Rtf) + k * C + k * (ks * (Rss + Rrs) + k * Rtr);

// ---- per-channel crossover (filters always running so state stays continuous) ----
// channel index: 0 L, 1 R, 2 C, 3 Lss, 4 Rss, 5 Lrs, 6 Rrs, 7 Ltf, 8 Rtf, 9 Ltr, 10 Rtr
hL   = hp(L,   0);  lL   = lp(L,   0);
hR   = hp(R,   1);  lR   = lp(R,   1);
hC   = hp(C,   2);  lC   = lp(C,   2);
hLss = hp(Lss, 3);  lLss = lp(Lss, 3);
hRss = hp(Rss, 4);  lRss = lp(Rss, 4);
hLrs = hp(Lrs, 5);  lLrs = lp(Lrs, 5);
hRrs = hp(Rrs, 6);  lRrs = lp(Rrs, 6);
hLtf = hp(Ltf, 7);  lLtf = lp(Ltf, 7);
hRtf = hp(Rtf, 8);  lRtf = lp(Rtf, 8);
hLtr = hp(Ltr, 9);  lLtr = lp(Ltr, 9);
hRtr = hp(Rtr, 10); lRtr = lp(Rtr, 10);

// low sums for the sub feed: only channels with BM on contribute
// centre is split 50/50 so L+R equals a mono sum
lowL0 = fL*lL + fLss*lLss + fLrs*lLrs + fLtf*lLtf + fLtr*lLtr + 0.5*fC*lC;
lowR0 = fR*lR + fRss*lRss + fRrs*lRrs + fRtf*lRtf + fRtr*lRtr + 0.5*fC*lC;
// 5.2 set: same weights as the fold-down
lowL1 = fL*lL + k*fLtf*lLtf + ks*(fLss*lLss + fLrs*lLrs) + k*fLtr*lLtr + 0.5*fC*lC;
lowR1 = fR*lR + k*fRtf*lRtf + ks*(fRss*lRss + fRrs*lRrs) + k*fRtr*lRtr + 0.5*fC*lC;

// channels with BM on get their high-passed signal; others stay full range
L   = fL   ? hL   : L;
R   = fR   ? hR   : R;
C   = fC   ? hC   : C;
Lss = fLss ? hLss : Lss;
Rss = fRss ? hRss : Rss;
Lrs = fLrs ? hLrs : Lrs;
Rrs = fRrs ? hRrs : Rrs;
Ltf = fLtf ? hLtf : Ltf;
Rtf = fRtf ? hRtf : Rtf;
Ltr = fLtr ? hLtr : Ltr;
Rtr = fRtr ? hRtr : Rtr;

bassL = (af <= 1 ? lowL0 : lowL1) * subg;
bassR = (af <= 1 ? lowR0 : lowR1) * subg;
bsum  = bassL + bassR;

// bto: 0 = both (mono sum), 1 = LFE1 only, 2 = LFE2 only, 3 = stereo
add1 = (bto == 3) ? bassL : ((bto != 2) ? bsum : 0);
add2 = (bto == 3) ? bassR : ((bto != 1) ? bsum : 0);

lfe1 = LF1 * lfeg + (bm ? add1 : 0);
lfe2 = LF2 * lfeg + (bm ? add2 : 0);

// meters: post bass management, pre fold-down / monitor level
pk(0, L);   pk(1, R);   pk(2, C);   pk(3, lfe1); pk(4, lfe2);
pk(5, Lss); pk(6, Rss); pk(7, Lrs); pk(8, Rrs);
pk(9, Ltf); pk(10, Rtf); pk(11, Ltr); pk(12, Rtr);

// clear all 50 outputs (inputs have already been read)
i = 0;
loop(64, spl(i) = 0; i += 1);

// cue sends leave the plugin on channels 49-60: post-fader, dimmed while that cue's
// talkback is on, plus the talkback mic.
// (the monitor / headphone cue sources use mem[420..431], which has no talkback)
i = 0;
loop(12,
  tv = (floor(i / 2) < ncue) ? (mem[420 + i] * mem[520 + floor(i / 2)] * cmgs + tk * mem[440 + floor(i / 2)]) : 0;
  mem[1100 + i] = tv;      // written to the Cues out start after the speaker level is applied
  pk2(260 + i, tv);
  i += 1;
);

// fold-downs for the smaller formats (heights into L/R and surrounds; ks keeps 5.x surrounds at full level)
L5  = L + k * Ltf;
R5  = R + k * Rtf;
Ls5 = ks * (Lss + Lrs) + k * Ltr;
Rs5 = ks * (Rss + Rrs) + k * Rtr;
Lo = L5 + k * C + k * Ls5;
Ro = R5 + k * C + k * Rs5;
// single LFE (7.1.4 / 5.1): both sub feeds and the bass in one channel
lfeS = (LF1 + LF2) * lfeg + (bm ? bsum : 0);

// speaker signals by speaker index for the active monitor format
i = 0;  loop(13, mem[1200 + i] = 0; i += 1;);
af <= 1 ? (
  mem[1200] = L;  mem[1201] = R;  mem[1202] = C;
  mem[1203] = af == 1 ? lfeS : lfe1;  mem[1204] = lfe2;
  mem[1205] = Lss; mem[1206] = Rss; mem[1207] = Lrs; mem[1208] = Rrs;
  mem[1209] = Ltf; mem[1210] = Rtf; mem[1211] = Ltr; mem[1212] = Rtr;
) : af <= 3 ? (
  mem[1200] = L5;  mem[1201] = R5;  mem[1202] = C;
  mem[1203] = af == 3 ? lfeS : lfe1;  mem[1204] = lfe2;
  mem[1205] = Ls5; mem[1206] = Rs5;
) : af == 4 ? (
  mem[1200] = L5 + k * C;  mem[1201] = R5 + k * C;
  mem[1203] = lfe1;  mem[1204] = lfe2;      // subs leave at the Subs out start
  mem[1205] = Ls5; mem[1206] = Rs5;
) : (
  mem[1200] = Lo;  mem[1201] = Ro;
  mem[1203] = lfe1;  mem[1204] = lfe2;      // subs leave at the Subs out start
);
slider4 ? ( foldm(0, 1); foldm(5, 6); foldm(7, 8); foldm(9, 10); foldm(11, 12); );

// per-speaker on/off (smoothed), monitor level / dim / mute, then write the active monitor and meter it
i = 0;
loop(13, mem[220 + i] += (mem[240 + i] - mem[220 + i]) * 0.002; i += 1);
nsp = nafs;
i = 0;
loop(nafs,
  ix = i < nafo ? fmt_idx(af, i) : i - nafo + 3;
  wv = mem[1200 + ix] * mem[220 + ix] * g;
  spl(i < nafo ? os + i : osub + i - nafo) = wv;
  pk2(500 + i, wv);
  i += 1;
);

// headphone out on channels 15/16 (not affected by speaker level, dim or mute)
spl(oc_hp) = hpl * hg;
spl(oc_hp + 1) = hpr * hg;
pk2(282, spl(oc_hp));
pk2(283, spl(oc_hp + 1));

// meter L/R on channels 23/24 (before the main monitors' level, dim and mute)
spl(oc_mt) = mtL;
spl(oc_mt + 1) = mtR;

// studio monitors out on channels 63/64 (independent of the main monitors' level, dim and mute)
spl(oc_stu) = stuL * sg;
spl(oc_stu + 1) = stuR * sg;
pk2(284, spl(oc_stu));
pk2(285, spl(oc_stu + 1));

// each cue leaves at its own output start (stereo pair)
i = 0;
loop(6, spl(mem[1510 + i]) = mem[1100 + 2 * i];  spl(mem[1510 + i] + 1) = mem[1101 + 2 * i];  i += 1);

// output check: peak of every plug-in output channel 1-64 as finally written (what goes to the hardware)
i = 0;
loop(64, pk2(700 + i, spl(i)); i += 1);

@gfx 360 3193
gfx_set(0.12, 0.12, 0.12);
gfx_rect(0, 0, gfx_w, gfx_h);
fcount += 1;

// releasing the mouse ends any fader/knob drag
!(mouse_cap & 1) ? drag_id = 0;

// sunken frame just outside a rectangle: dark on top/left, light on bottom/right
function inset(x, y, w, h) (
  gfx_set(0, 0, 0, 0.75);
  gfx_rect(x - 1, y - 1, w + 2, 1);
  gfx_rect(x - 1, y - 1, 1, h + 2);
  gfx_set(1, 1, 1, 0.18);
  gfx_rect(x - 1, y + h, w + 2, 1);
  gfx_rect(x + w, y - 1, 1, h + 2);
  gfx_a = 1;
);

// raised (or pressed) 3D button face: vertical gradient with bevelled edges
function bevel(x, y, w, h, r, g, b, pressed) local(i, t, f, by0, bh) (
  i = 0;
  loop(8,
    t = i / 7;                                                  // 0 = top .. 1 = bottom
    f = pressed ? (0.80 + 0.12 * t) : (1.22 - 0.42 * t);        // lit from above
    gfx_set(min(1, r * f), min(1, g * f), min(1, b * f));
    by0 = y + floor(h * i / 8);
    bh  = min(ceil(h / 8) + 1, y + h - by0);
    gfx_rect(x, by0, w, bh);
    i += 1;
  );
  // light on top/left, dark on bottom/right (reversed when pressed)
  pressed ? gfx_set(0, 0, 0, 0.55) : gfx_set(1, 1, 1, 0.45);
  gfx_rect(x, y, w, 1);
  gfx_rect(x, y, 1, h);
  pressed ? gfx_set(1, 1, 1, 0.22) : gfx_set(0, 0, 0, 0.55);
  gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x + w - 1, y, 1, h);
  gfx_a = 1;
);

function btn(x, y, w, h, label, on) local(hit, tw, th, inside, pressed, o) (
  inside  = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  pressed = (mouse_cap & 1) && inside;
  on ? bevel(x, y, w, h, 0.15, 0.65, 0.30, pressed) : bevel(x, y, w, h, 0.30, 0.30, 0.30, pressed);
  o = pressed ? 1 : 0;
  gfx_measurestr(label, tw, th);
  gfx_set(0, 0, 0, 0.6);
  gfx_x = x + (w - tw) / 2 + o + 1;  gfx_y = y + (h - th) / 2 + o + 1;
  gfx_drawstr(label);
  gfx_set(1, 1, 1);
  gfx_x = x + (w - tw) / 2 + o;      gfx_y = y + (h - th) / 2 + o;
  gfx_drawstr(label);
  hit = (mouse_cap & 1) && !last_cap && inside;
  hit;
);

// expandable section header bar: returns 1 on click
function section_header(x, y, w, h, label, open) local(hit, tw, th, inside, pressed) (
  inside  = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  pressed = (mouse_cap & 1) && inside;
  bevel(x, y, w, h, 0.24, 0.24, 0.31, pressed);
  gfx_set(0.9, 0.9, 0.9);
  open ? gfx_triangle(x + 8, y + 7, x + 18, y + 7, x + 13, y + 15)
       : gfx_triangle(x + 9, y + 5, x + 9, y + 17, x + 17, y + 11);
  gfx_measurestr(label, tw, th);
  gfx_x = x + 26;
  gfx_y = y + (h - th) / 2;
  gfx_drawstr(label);
  hit = (mouse_cap & 1) && !last_cap && inside;
  hit;
);

// vertical fader: returns the new value. Drag to set, Ctrl/Cmd-click to reset.
function fader(x, ytop, ybot, label, val, vmin, vmax, vstep, vdef, id)
  local(xc, t, yh, y0, inside, clicked, tw, th) (
  xc = x + 15;

  inside = mouse_x >= x && mouse_x < x + 30 && mouse_y >= ytop - 8 && mouse_y <= ybot + 8;
  clicked = (mouse_cap & 1) && !last_cap && inside;
  clicked ? ( (mouse_cap & 4) ? (val = vdef) : (drag_id = id); );

  (drag_id == id && (mouse_cap & 1)) ? (
    t = (ybot - mouse_y) / (ybot - ytop);
    t = max(0, min(1, t));
    val = vmin + t * (vmax - vmin);
    val = floor(val / vstep + 0.5) * vstep;
    val = max(vmin, min(vmax, val));
  );

  t  = (val - vmin) / (vmax - vmin);
  yh = ybot - t * (ybot - ytop);

  // groove (sunken) and fill
  gfx_set(0.05, 0.05, 0.05);
  gfx_rect(xc - 2, ytop, 4, ybot - ytop);
  inset(xc - 2, ytop, 4, ybot - ytop);
  gfx_set(0.15, 0.65, 0.3);
  gfx_rect(xc - 2, yh, 4, ybot - yh);

  // 0 dB tick, when 0 is inside the range
  (vmin < 0 && vmax > 0) ? (
    y0 = ybot - ((0 - vmin) / (vmax - vmin)) * (ybot - ytop);
    gfx_set(0.6, 0.6, 0.6);
    gfx_rect(xc - 11, y0, 22, 1);
  );

  // handle: raised cap with a grip line (pushed in while dragging)
  bevel(xc - 13, yh - 6, 26, 12, 0.78, 0.78, 0.80, drag_id == id && (mouse_cap & 1));
  gfx_set(0.1, 0.1, 0.1);
  gfx_rect(xc - 9, yh, 18, 1);
  gfx_set(1, 1, 1, 0.5);
  gfx_rect(xc - 9, yh + 1, 18, 1);
  gfx_a = 1;

  // label above the track, value below
  gfx_set(0.85, 0.85, 0.85);
  gfx_measurestr(label, tw, th);
  gfx_x = xc - tw / 2;  gfx_y = ytop - 22;
  gfx_drawstr(label);

  vstep >= 1 ? sprintf(#vs, "%.0f", val) : sprintf(#vs, "%.1f", val);
  gfx_measurestr(#vs, tw, th);
  gfx_x = xc - tw / 2;  gfx_y = ybot + 10;
  gfx_drawstr(#vs);

  val;
);

// speaker on/off button: green = on, red = muted, dark = not part of the active layout
function spk_btn(x, y, w, h, label, on, avail) local(hit, tw, th) (
  avail ? (on ? gfx_set(0.15, 0.65, 0.3) : gfx_set(0.6, 0.2, 0.2)) : gfx_set(0.17, 0.17, 0.17);
  gfx_rect(x, y, w, h);
  avail ? gfx_set(1, 1, 1) : gfx_set(0.4, 0.4, 0.4);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) / 2;
  gfx_y = y + (h - th) / 2;
  gfx_drawstr(label);
  hit = avail && (mouse_cap & 1) && !last_cap &&
        mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  hit;
);

// monitor source button: blue = selected
function src_btn(x, y, w, h, label, on) local(hit, tw, th, inside, pressed, o) (
  inside  = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  pressed = (mouse_cap & 1) && inside;
  on ? bevel(x, y, w, h, 0.20, 0.45, 0.85, pressed) : bevel(x, y, w, h, 0.30, 0.30, 0.30, pressed);
  o = pressed ? 1 : 0;
  gfx_measurestr(label, tw, th);
  gfx_set(0, 0, 0, 0.6);
  gfx_x = x + (w - tw) / 2 + o + 1;  gfx_y = y + (h - th) / 2 + o + 1;
  gfx_drawstr(label);
  gfx_set(1, 1, 1);
  gfx_x = x + (w - tw) / 2 + o;      gfx_y = y + (h - th) / 2 + o;
  gfx_drawstr(label);
  hit = (mouse_cap & 1) && !last_cap && inside;
  hit;
);

// vertical meter bar, 7 px wide, -60..0 dB
function vmeter(x, ytop, ybot, a) local(db, h) (
  db = a > 0.000001 ? 20 * log10(a) : -120;
  h  = max(0, min(1, (db + 60) / 60)) * (ybot - ytop);
  gfx_set(0.07, 0.07, 0.07);
  gfx_rect(x, ytop, 7, ybot - ytop);
  inset(x, ytop, 7, ybot - ytop);
  a > 0.7 ? gfx_set(0.9, 0.2, 0.2) : (a > 0.25 ? gfx_set(0.9, 0.8, 0.2) : gfx_set(0.2, 0.8, 0.35));
  gfx_rect(x, ybot - h, 7, h);
);

// horizontal meter bar, 7 px tall, -60..0 dB
function hmeter(x, y, w, a) local(db, t) (
  db = a > 0.000001 ? 20 * log10(a) : -120;
  t  = max(0, min(1, (db + 60) / 60));
  gfx_set(0.07, 0.07, 0.07);
  gfx_rect(x, y, w, 7);
  inset(x, y, w, 7);
  a > 0.7 ? gfx_set(0.9, 0.2, 0.2) : (a > 0.25 ? gfx_set(0.9, 0.8, 0.2) : gfx_set(0.2, 0.8, 0.35));
  gfx_rect(x, y, w * t, 7);
);

// vertical meter bar of any width, -60..0 dB
function vbar(x, ytop, ybot, w, a) local(db, h) (
  db = a > 0.000001 ? 20 * log10(a) : -120;
  h  = max(0, min(1, (db + 60) / 60)) * (ybot - ytop);
  gfx_set(0.07, 0.07, 0.07);
  gfx_rect(x, ytop, w, ybot - ytop);
  inset(x, ytop, w, ybot - ytop);
  a > 0.7 ? gfx_set(0.9, 0.2, 0.2) : (a > 0.25 ? gfx_set(0.9, 0.8, 0.2) : gfx_set(0.2, 0.8, 0.35));
  gfx_rect(x, ybot - h, w, h);
);

// speaker button for the layout map: on/off with a small vertical level bar on its right edge.
// green = on, red = muted, dark = not part of the active layout. Returns 1 on click.
function spk_map(x, y, w, h, label, on, avail, a)
  local(hit, tw, th, db, mh, inside, pressed, o) (
  inside  = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  pressed = avail && (mouse_cap & 1) && inside;
  avail ? (on ? bevel(x, y, w, h, 0.15, 0.65, 0.30, pressed) : bevel(x, y, w, h, 0.62, 0.20, 0.20, pressed))
        : bevel(x, y, w, h, 0.17, 0.17, 0.17, 0);

  (avail && on) ? (
    db = a > 0.000001 ? 20 * log10(a) : -120;
    mh = max(0, min(1, (db + 60) / 60)) * (h - 4);
    gfx_set(0.05, 0.2, 0.1);
    gfx_rect(x + w - 7, y + 2, 5, h - 4);
    a > 0.7 ? gfx_set(1, 0.3, 0.3) : (a > 0.25 ? gfx_set(1, 0.9, 0.3) : gfx_set(0.7, 1, 0.75));
    gfx_rect(x + w - 7, y + 2 + (h - 4) - mh, 5, mh);
  );

  o = pressed ? 1 : 0;
  gfx_measurestr(label, tw, th);
  avail ? gfx_set(0, 0, 0, 0.6) : gfx_set(0, 0, 0, 0.0);
  gfx_x = x + (w - 8 - tw) / 2 + o + 1;  gfx_y = y + (h - th) / 2 + o + 1;
  gfx_drawstr(label);
  avail ? gfx_set(1, 1, 1) : gfx_set(0.4, 0.4, 0.4);
  gfx_x = x + (w - 8 - tw) / 2 + o;      gfx_y = y + (h - th) / 2 + o;
  gfx_drawstr(label);

  hit = avail && (mouse_cap & 1) && !last_cap && inside;
  hit;
);

// editable value field: double-click to type, mouse wheel to step, Ctrl/Cmd-click to reset.
// fmt: 0 = "80 Hz", 1 = "0.0 dB", 2 = plain integer. Returns the new value.
function valfield(x, y, w, h, val, vmin, vmax, vdef, step, fmt, fid)
  local(inside, clicked, c, ev, tw, th) (
  inside  = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  clicked = (mouse_cap & 1) && !last_cap;

  (edit_id == fid) ? (
    // ---- typing mode ----
    clicked && !inside ? ( edit_id = 0; );
    while ((c = gfx_getchar()) > 0) (
      ((c >= 48 && c <= 57) || c == 46 || c == 45) ? (
        strlen(#ebuf) < 8 ? ( sprintf(#ech, "%c", c); strcat(#ebuf, #ech); );
      ) : (c == 8) ? (
        strcpy_substr(#etmp, #ebuf, 0, max(0, strlen(#ebuf) - 1));
        strcpy(#ebuf, #etmp);
      ) : (c == 13) ? (
        match("%f", #ebuf, ev) ? ( val = ev; );
        edit_id = 0;
      ) : (c == 27) ? (
        edit_id = 0;
      );
    );
  ) : (
    // ---- normal mode ----
    clicked && inside ? (
      (mouse_cap & 4) ? ( val = vdef; ) : (
        ((fcount - last_click_f) < 15 && last_click_id == fid) ? (
          edit_id = fid;
          strcpy(#ebuf, "");
          last_click_f = -1000;
        ) : ( last_click_f = fcount;  last_click_id = fid; );
      );
    );
    (inside && mouse_wheel != 0) ? (
      val += (mouse_wheel > 0 ? step : -step);
      mouse_wheel = 0;
    );
  );

  val = max(vmin, min(vmax, val));
  val = floor(val / step + 0.5) * step;

  // ---- draw ----
  (edit_id == fid) ? (
    gfx_set(0.95, 0.95, 0.95);
    gfx_rect(x, y, w, h);
    inset(x, y, w, h);
    gfx_set(0, 0, 0);
    sprintf(#vf, "%s_", #ebuf);
  ) : (
    gfx_set(0.07, 0.07, 0.07);
    gfx_rect(x, y, w, h);
    inset(x, y, w, h);
    gfx_set(0.85, 0.85, 0.85);
    fmt == 0 ? sprintf(#vf, "%.0f Hz", val) : (fmt == 1 ? sprintf(#vf, "%.1f dB", val) : sprintf(#vf, "%.0f", val));
  );
  gfx_measurestr(#vf, tw, th);
  gfx_x = x + (w - tw) / 2;
  gfx_y = y + (h - th) / 2;
  gfx_drawstr(#vf);

  val;
);

// talkback button: red = live
function talk_btn(x, y, w, h, label, on) local(hit, tw, th, inside, pressed, o) (
  inside  = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  pressed = (mouse_cap & 1) && inside;
  on ? bevel(x, y, w, h, 0.85, 0.20, 0.20, pressed) : bevel(x, y, w, h, 0.30, 0.30, 0.30, pressed);
  o = pressed ? 1 : 0;
  gfx_measurestr(label, tw, th);
  gfx_set(0, 0, 0, 0.6);
  gfx_x = x + (w - tw) / 2 + o + 1;  gfx_y = y + (h - th) / 2 + o + 1;
  gfx_drawstr(label);
  gfx_set(1, 1, 1);
  gfx_x = x + (w - tw) / 2 + o;      gfx_y = y + (h - th) / 2 + o;
  gfx_drawstr(label);
  hit = (mouse_cap & 1) && !last_cap && inside;
  hit;
);

// compact horizontal fader: groove, bevelled handle, value text to the right. Returns the new value.
function hfader2(x, y, w, val, vmin, vmax, vstep, vdef, id)
  local(t, xh, inside, clicked, x0db) (
  inside  = mouse_x >= x - 5 && mouse_x <= x + w + 5 && mouse_y >= y && mouse_y < y + 22;
  clicked = (mouse_cap & 1) && !last_cap && inside;
  clicked ? ( (mouse_cap & 4) ? (val = vdef) : (drag_id = id); );

  (drag_id == id && (mouse_cap & 1)) ? (
    t = (mouse_x - x) / w;
    t = max(0, min(1, t));
    val = vmin + t * (vmax - vmin);
    val = floor(val / vstep + 0.5) * vstep;
    val = max(vmin, min(vmax, val));
  );

  t  = (val - vmin) / (vmax - vmin);
  xh = x + t * w;

  gfx_set(0.05, 0.05, 0.05);
  gfx_rect(x, y + 9, w, 4);
  inset(x, y + 9, w, 4);
  gfx_set(0.15, 0.65, 0.3);
  gfx_rect(x, y + 9, xh - x, 4);

  (vmin < 0 && vmax > 0) ? (
    x0db = x + ((0 - vmin) / (vmax - vmin)) * w;
    gfx_set(0.6, 0.6, 0.6);
    gfx_rect(x0db, y + 5, 1, 12);
  );

  bevel(xh - 5, y + 2, 10, 18, 0.78, 0.78, 0.80, drag_id == id && (mouse_cap & 1));
  gfx_set(0.1, 0.1, 0.1);
  gfx_rect(xh, y + 6, 1, 10);
  gfx_set(1, 1, 1, 0.5);
  gfx_rect(xh + 1, y + 6, 1, 10);
  gfx_a = 1;

  sprintf(#hv2, "%.1f", val);
  gfx_set(0.85, 0.85, 0.85);
  gfx_x = x + w + 6;  gfx_y = y + 5;
  gfx_drawstr(#hv2);

  val;
);

// dB scale for a vertical meter (0 to -60 dB, every 10 dB): ticks and labels on both sides of the bars
function dbscale(xl, xr, ytop, ybot) local(d, y, tw, th) (
  d = 0;
  loop(7,
    y = ybot - ((d + 60) / 60) * (ybot - ytop);
    gfx_set(0.55, 0.55, 0.58);
    gfx_rect(xl - 3, y, 3, 1);
    gfx_rect(xr + 1, y, 3, 1);
    sprintf(#dbt, "%.0f", d);
    gfx_measurestr(#dbt, tw, th);
    gfx_x = xl - 5 - tw;  gfx_y = y - th / 2;  gfx_drawstr(#dbt);
    gfx_x = xr + 6;       gfx_y = y - th / 2;  gfx_drawstr(#dbt);
    d -= 10;
  );
);

// Rotary knob with double-click-to-type value field. Returns the new value.
// Drag = turn, Shift = fine, wheel = step, Ctrl/Cmd-click = reset, double-click value = type.
function knob(cx, cy, r, label, val, vmin, vmax, vdef, kid)
  local(fw, fh, fx, fy, span, t, dx, dy, in_k, in_f, clicked, c, ev,
        i, a0, a1, rr, ang, tw, th, f, nt) (
  fw = 58;  fh = 18;
  fx = cx - fw / 2;  fy = cy + 50;
  span = vmax - vmin;

  dx = mouse_x - cx;  dy = mouse_y - cy;
  in_k = sqrt(dx * dx + dy * dy) <= r + 8;
  in_f = mouse_x >= fx && mouse_x < fx + fw && mouse_y >= fy && mouse_y < fy + fh;
  clicked = (mouse_cap & 1) && !last_cap;

  (edit_id == kid) ? (
    // ---- typing mode ----
    clicked && !in_f ? ( edit_id = 0; );
    while ((c = gfx_getchar()) > 0) (
      ((c >= 48 && c <= 57) || c == 46 || c == 45) ? (
        strlen(#ebuf) < 8 ? ( sprintf(#ech, "%c", c); strcat(#ebuf, #ech); );
      ) : (c == 8) ? (
        strcpy_substr(#etmp, #ebuf, 0, max(0, strlen(#ebuf) - 1));
        strcpy(#ebuf, #etmp);
      ) : (c == 13) ? (
        match("%f", #ebuf, ev) ? ( val = ev; );
        edit_id = 0;
      ) : (c == 27) ? (
        edit_id = 0;
      );
    );
  ) : (
    // ---- normal mode ----
    clicked && in_f ? (
      ((fcount - last_click_f) < 15 && last_click_id == kid) ? (
        edit_id = kid;
        strcpy(#ebuf, "");
        last_click_f = -1000;
      ) : ( last_click_f = fcount; last_click_id = kid; );
    );
    clicked && in_k ? (
      (mouse_cap & 4) ? ( val = vdef; ) : ( drag_id = kid; klast_y = mouse_y; );
    );
    (drag_id == kid && (mouse_cap & 1)) ? (
      val += (klast_y - mouse_y) * (span / 220) * ((mouse_cap & 8) ? 0.1 : 1);
      klast_y = mouse_y;
    );
    (in_k && mouse_wheel != 0) ? (
      val += (mouse_wheel > 0 ? 1 : -1) * span / 130;
      mouse_wheel = 0;
    );
  );

  val = max(vmin, min(vmax, val));

  // ---- draw ----
  t = (val - vmin) / span;

  kstyle == 1 ? (
    // ---- SSL-style main level knob: black knurled cylinder, white pointer line, printed scale ring ----
    // scale ticks every 6 dB (long ticks at -60, -30, 0 and +6)
    nt = floor(span / 6) + 1;
    i = 0;
    loop(nt,
      a0 = (-135 + 270 * (i * 6) / span) * $pi / 180;
      f  = (i % 5 == 0 || i == nt - 1) ? max(5, r * 0.22) : max(3, r * 0.12);
      gfx_set(0.80, 0.80, 0.82);
      gfx_line(cx + sin(a0) * (r + 5), cy - cos(a0) * (r + 5), cx + sin(a0) * (r + 5 + f), cy - cos(a0) * (r + 5 + f));
      i += 1;
    );

    // skirt, knurled edge and flat top
    gfx_set(0.02, 0.02, 0.02);
    gfx_circle(cx, cy, r + 3, 1, 1);
    gfx_set(0.15, 0.15, 0.16);
    gfx_circle(cx, cy, r, 1, 1);
    i = 0;
    loop(48,
      a0 = i * 2 * $pi / 48;
      gfx_set(0.04, 0.04, 0.04);
      gfx_line(cx + sin(a0) * (r - 5), cy - cos(a0) * (r - 5), cx + sin(a0) * (r - 1), cy - cos(a0) * (r - 1));
      i += 1;
    );
    gfx_set(0.075, 0.075, 0.08);
    gfx_circle(cx, cy, r - 6, 1, 1);
    gfx_set(0.105, 0.105, 0.115);
    gfx_circle(cx - 3, cy - 3, r - 16, 1, 1);
    gfx_set(0.085, 0.085, 0.09);
    gfx_circle(cx, cy, r - 20, 1, 1);

    // white pointer line, from near the centre out to the edge of the top
    ang = (-135 + 270 * t) * $pi / 180;
    gfx_set(0.96, 0.96, 0.96);
    gfx_line(cx + sin(ang) * (r * 0.30), cy - cos(ang) * (r * 0.30), cx + sin(ang) * (r - 5), cy - cos(ang) * (r - 5));
    gfx_line(cx + sin(ang) * (r * 0.30) + 1, cy - cos(ang) * (r * 0.30), cx + sin(ang) * (r - 5) + 1, cy - cos(ang) * (r - 5));
